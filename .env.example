# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so your secrets never get committed.
#
# Deploying to Vercel (or any host)? .env.local only affects your machine —
# add these same variables in your host's dashboard too (for Vercel:
# Project Settings → Environment Variables), or the deployed app won't see
# them. NEXT_PUBLIC_* variables are baked in at build time, so redeploy
# after changing one.

# ── Storage (Upstash Redis) ─────────────────────────────────────────────────
# Create a free database at https://console.upstash.com, then copy its
# REST URL and token here. If left unset, the app falls back to storing
# bets in a local data/bets.json file — handy for trying things out, but
# NOT suitable for serverless platforms like Vercel (the filesystem is
# ephemeral there), so set these before deploying.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Branding ─────────────────────────────────────────────────────────────
# Shown in the header, footer, and browser tab title.
NEXT_PUBLIC_SITE_NAME=Slipbook
NEXT_PUBLIC_SITE_DESCRIPTION=Personal betting tracker

# ── Currency & units ─────────────────────────────────────────────────────
# ISO 4217 currency code (e.g. GBP, USD, EUR) used for stake/returns entry
# in the admin area only — the public tracker view never shows real
# currency, only anonymised "units" (see UNIT_SIZE below).
NEXT_PUBLIC_CURRENCY=GBP

# How much stake/returns currency equals 1 "unit" in the public tracker
# view (e.g. 100 means a £100/€100/$100 stake shows as 1.00u).
NEXT_PUBLIC_UNIT_SIZE=100

# ── AI features (optional) ──────────────────────────────────────────────
# One key powers everything AI-related — all of it is optional and the rest
# of the admin panel works fine without it:
#   - Drag-and-drop a betslip screenshot to auto-fill a new bet
#   - "Describe it" — turn a plain-English sentence into a bet
#   - "Suggest Result" — web-search a pending bet's real-world outcome as a
#     reviewable suggestion (never auto-settles anything)
#   - Generate a short AI performance summary shown on the Insights page
# Get a key at https://console.anthropic.com — leave unset to disable all
# of the above; every other feature still works normally.
ANTHROPIC_API_KEY=

# ── Admin access ─────────────────────────────────────────────────────────
# PIN used to unlock the /admin page for adding/editing/deleting bets.
# Change this to your own PIN. Deliberately NOT prefixed with NEXT_PUBLIC_ —
# it's checked server-side only (src/app/api/admin/login) and never sent to
# the browser, so it won't appear in the deployed JS bundle. Still just a
# PIN gate, not a full auth system — don't reuse a sensitive password here.
ADMIN_PIN=000000
